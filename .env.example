# Application Configuration
APP_NAME=Job Crawler API
DEBUG=false
LOG_LEVEL=INFO

# Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=job_crawler
MYSQL_USER=crawler_user
MYSQL_PASSWORD=your_secure_password_here
MYSQL_ROOT_PASSWORD=your_root_password_here

# Optional: Full DATABASE_URL (overrides individual MySQL settings)
# DATABASE_URL=mysql+pymysql://user:password@host:3306/database

# Database SSL Configuration (Optional)
DB_SSL_ENABLED=false
DB_SSL_CA=ca-cert.pem
DB_SSL_CERT=client-cert.pem
DB_SSL_KEY=client-key.pem
DB_SSL_CHECK_HOSTNAME=true
DB_SSL_VERIFY_IDENTITY=true

# Crawler Configuration
CRAWLER_HEADLESS=true
CRAWLER_DELAY_MIN=2.0
CRAWLER_DELAY_MAX=5.0
CRAWLER_COOKIES_PATH=